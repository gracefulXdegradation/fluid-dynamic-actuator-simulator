{
	"name": "Simulator Container",
	"dockerComposeFile": ["../../docker-compose.yml"],
	"service": "simulator",
	"shutdownAction": "none",
	"workspaceFolder": "/workspace/simulator",
	"postCreateCommand": "cmake -S . -B build && cmake --build ${containerWorkspaceFolder}/build && sudo ${containerWorkspaceFolder}/build/bin/job_processor"
}
